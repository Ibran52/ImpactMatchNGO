NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/impact_match
# SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_TTL_DAYS=14
CLIENT_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000

# Razorpay Test Mode only. Configure all three values to enable donations.
# The webhook secret is server-only and must match the Razorpay webhook configuration.
# RAZORPAY_KEY_ID=rzp_test_replace_me
# RAZORPAY_KEY_SECRET=replace_with_test_key_secret
# RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Optional bootstrap administrator. Use a unique local-development password.
# ADMIN_EMAIL=admin@example.test
# ADMIN_PASSWORD=replace-with-a-unique-local-admin-password

# Dedicated database only; required to opt into payment integration tests.
# PAYMENT_TEST_MONGODB_URI=mongodb://127.0.0.1:27017/impact_match_payment_test

# Private filesystem storage. Relative paths resolve from the server process
# working directory. Request documents, item photos, and pickup evidence use
# this storage and the shared upload limits below. Use a persistent private
# volume in production; this adapter does not provide external object storage.
PRIVATE_STORAGE_DIR=private-uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_FILES=5
NGO_MATCH_RADIUS_KM=50
NGO_MATCH_MAX_RESULTS=10
VOLUNTEER_MATCH_RADIUS_KM=30
VOLUNTEER_MATCH_MAX_OFFERS=10
VOLUNTEER_OFFER_TTL_HOURS=24

# Optional OCR. Configuring this sends uploaded JPEG/PNG/WebP bytes to Google
# Cloud Vision. OCR also requires a private 32-byte key (64 hex characters or
# 32-byte standard base64) to encrypt extracted text at rest. PDFs are stored
# but are not currently passed to OCR.
# GOOGLE_VISION_API_KEY=replace_with_google_vision_api_key
# REQUEST_DATA_ENCRYPTION_KEY=replace_with_a_private_32_byte_encryption_key

# NGO matching: verified service-category match plus geospatial distance when
# coordinates exist; city/service-area matching is used as a fallback.
# Volunteer offers require an active account marked eligible by an admin,
# explicit task opt-in, matching skills/categories, remaining assignment
# capacity, and distance/service-area eligibility.

# Optional AI screening. Configuring this sends request details and extracted
# text to OpenAI. AI results are suggestions for a human reviewer only.
# Completion evidence is sent for text-only analysis only when the volunteer
# explicitly opts in on submission. If they opt in, supported image files may
# be sent to Google Vision for OCR; the report and extracted text may be sent
# to OpenAI. Neither provider can approve or close a request.
# OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Email/SMS notification provider is not implemented; in-app notifications
# are stored in MongoDB.
# NOTIFICATION_PROVIDER=
# NOTIFICATION_CREDENTIALS=
